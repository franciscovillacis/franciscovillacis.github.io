---
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface PageData {
  title?: string;
  description?: string;
}

const page = (Astro.props.frontmatter ?? Astro.props) as PageData;
const title = page.title ?? "Home";
const description =
  page.description ?? "Academic website of Francisco Villacis";
const pageTitle =
  title === "Home" ? "Francisco Villacis" : `${title} | Francisco Villacis`;
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isResearch = currentPath.startsWith("/research");
const canonicalURL = Astro.site
  ? new URL(currentPath, Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9f7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header>
      <nav aria-label="Primary navigation">
        <a href="/" aria-current={isHome ? "page" : undefined}>Home</a>
        <a href="/research/" aria-current={isResearch ? "page" : undefined}>
          Research
        </a>
        <a href="/cv.pdf" target="_blank" rel="noopener noreferrer">CV</a>
      </nav>
    </header>
    <main id="content">
      <div class:list={{ reading: !isHome }}>
        <slot />
      </div>
    </main>
    <footer>Francisco Villacis · University of Waterloo</footer>
  </body>
</html>
